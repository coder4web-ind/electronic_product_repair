<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="electronic_product_device_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_electronic_product_device_form_inherit_product_template" model="ir.ui.view">
        <field name="name">electronic.product.device.form.inherit.product.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add a custom tab into the product notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Gadget Settings" name="electronic_gadget_settings">
                    <group>
                        <group string="Device Specifications">
                            <field name="product_brand_id" required=1 />
                            <field name="main_board_part_no"/>
                            <field name="sim_card_type"/>
                            <field name="pdf_service_manual"/>
                        </group>
                        <group string="Serial &amp; IMEI Validation">
                            <field name="required_imei"/>
                            <field name="required_serial_no"/>
                            <field name="serial_format"/>
                        </group>
                    </group>
                    <group string="Warranty Info">
                        <group>
                            <field name="brand_warranty_months"/>
                            <field name="carrier_warranty_months"/>
                            <field name="accessory_warranty_months"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>