<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="electronic_product_brand_action" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">electronic.product.brand</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="repair_clinic_brand_view_list" model="ir.ui.view">
        <field name="name">electronic.product.brand.list</field>
        <field name="model">electronic.product.brand</field>
        <field name="arch" type="xml">
            <list string="Repair Device Brand Grid">
                <field name="name" string="Name"/>
                <field name="logo" widget="image" options="{'size': [40, 40]}" class="oe_avatar"/>
                <field name="code" string="Code"/>
            </list>
        </field>
    </record>
    <record id="repair_clinic_brand_form" model="ir.ui.view">
        <field name="name">electronic.product.brand.form</field>
        <field name="model">electronic.product.brand</field>
        <field name="arch" type="xml">
            <form string="New Brand" create="1" edit="1">
                <sheet>
                    <group string="Global Brand Configuration">
                        <group>
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="name" string="Brand"/>
                            <field name="code" string="Code"/>
                            <field name="partner_id" string="Brand Partner" />                            
                        </group>
                        <group string="Warranty Info">
                            <field name="manufacturer_warranty_months" string="Standard Warranty (Months)"/>
                            <field name="carrier_warranty_months" string="Carrier Warranty (Months)"/>
                            <field name="accessory_warranty_months" string="Warranty on accessory"/>
                            <field name="repair_productivity_minutes" string="Standard Repair Time (Mins)" />
                            <field name="repeat_repair_period_days" string="Repeat Repair Window (Days)" />
                        </group>
                        <separator/>
                        <group string="Imei/Serial">
                            <field name="required_imeino"/>
                            <field name="required_serial_no"/>
                            <field name="required_fault_code"/>
                            <field name="required_firmware" />                            
                        </group>
                        <group string="QA and Intake Workflow">
                            <field name="use_qa" />
                            <field name="complete_on_qa_pass"/>
                            <field name="force_booking_symptom"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>